{"is_source_file": true, "format": "m4", "description": "This file contains a shell script (or script-like instructions) intended for VLAN configuration validation on LAN ports using UCI (Unified Configuration Interface) on a device running a Linux-based network system, possibly embedded firmware. It includes comments explaining prerequisites, purpose, and steps for creating VLANs, verifying configurations, and validating sub-interface presence.", "external_files": ["/etc/init.d/network", "uci", "grep", "sed", "sort", "ip"], "external_methods": ["uci -q set", "uci set", "uci show", "sed", "grep", "sort", "cut", "/etc/init.d/network reload"], "published": [], "classes": [], "methods": [], "calls": ["uci -q set network.vlan10='device'", "uci set network.vlan10.name='br-lan.10'", "uci set network.vlan10.type='8021q'", "uci set network.vlan10.ifname='br-lan'", "uci set network.vlan10.vid='10'", "uci -q commit network", "/etc/init.d/network reload", "uci show network", "grep -E 'network.vlan10'", "sed 's/@[0-9]\\+/@N/g'", "sort", "ip -o link show", "grep -E 'br-lan\\.10'", "sed -E 's/@.*>/:>/g;s/link\\/ether [0-9a-f:]+/link\\/ether XX:XX:XX:XX:XX:XX/g'", "cut -d' ' -f2-", "sort"], "search-terms": ["VLAN", "UCI", "LAN ports", "VLAN configuration", "network.vlan10", "test validation", "DAS", "swconfig"], "state": 2, "file_id": 8, "knowledge_revision": 50, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "b0aa2b7956d86c80a2fc549fd70fe088", "format-version": 4, "code-base-name": "cram_sample-2632", "filename": "sample_case/11-lan-vlan-config.t", "revision_history": [{"50": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}