{"is_source_file": true, "format": "shell script", "description": "This file contains a shell script that tests changing the default IPv4 firewall forwarding policy. It verifies the presence of appropriate iptables rules when setting the policy to REJECT and ACCEPT, and then restores the original policy. The script uses commands like uci, iptables, and init.d scripts to manipulate and verify firewall rules.", "external_files": ["/etc/init.d/firewall"], "external_methods": ["uci", "iptables"], "published": [], "classes": [], "methods": [], "calls": ["uci -q get firewall.defaults.forward", "uci -q set firewall.defaults.forward='REJECT'", "/etc/init.d/firewall reload", "iptables -S FORWARD", "grep -E -- '-j (reject|REJECT|DROP)'", "sed 's/[[:space:]]\\+/ /g'", "sort", "uniq", "uci -q set firewall.defaults.forward='ACCEPT'", "/etc/init.d/firewall reload"], "search-terms": ["firewall configuration", "iptables forwarding policy", "uci", "firewall reload", "iptables rules verification"], "state": 2, "file_id": 2, "knowledge_revision": 44, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "2f32881c989b8994fcf7f1148221f50d", "format-version": 4, "code-base-name": "cram_sample-2632", "filename": "sample_case/19-iptables-forward-policy.t", "revision_history": [{"44": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}