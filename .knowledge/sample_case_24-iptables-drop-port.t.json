{"is_source_file": true, "format": "shell script (bash)", "description": "This file is a shell script that tests managing an iptables DROP rule on a specific TCP port, validates that the port is blocked via netcat, and performs cleanup afterward. It includes commands to list current rules, insert a drop rule, verify rule presence, test connectivity, remove the rule, and dump the current iptables configuration.", "external_files": ["sample_case/01-sample.t", "sample_case/02-sample2.t", "/sbin/iptables", "/bin/awk", "/bin/sed", "/bin/grep", "/bin/echo", "/bin/nc"], "external_methods": ["iptables -L", "iptables -S", "iptables -D", "iptables-save", "awk", "sed", "grep", "nc"], "published": [], "classes": [], "methods": [], "calls": ["iptables -L INPUT -n -v", "awk 'NR==1 {print}'", "sed 's/[[:space:]]\\+\\?/ /g'", "iptables -S INPUT", "grep -E -- \"-p tcp .* --dport ${TEST_PORT} .* -j DROP\"", "sort", "uniq", "nc -z -w2 127.0.0.1 ${TEST_PORT}", "grep -q '^OK$'", "iptables -D INPUT -p tcp --dport ${TEST_PORT} -j DROP", "iptables-save"], "search-terms": ["iptables manage DROP rule", "test TCP port", "iptables script", "port blocking verification", "iptables cleanup script"], "state": 2, "file_id": 20, "knowledge_revision": 62, "git_revision": "5679f7f0affedf4292e4795631a77f50d15a7c39", "hash": "5a31aa6e74f059c960ecca9306236a01", "format-version": 4, "code-base-name": "cram_sample-2632", "filename": "sample_case/24-iptables-drop-port.t", "revision_history": [{"62": "5679f7f0affedf4292e4795631a77f50d15a7c39"}]}