{"is_source_file": true, "format": "shell script", "description": "This file contains a shell script designed to automate testing and validation of UCI (Unified Configuration Interface) configuration cycles for wireless and network services on a Linux-based device. It includes commands to set, commit, verify, and reload network configurations related to wireless isolation settings and global network parameters, with emphasis on ensuring configuration changes are correctly applied and persistent.", "external_files": ["/etc/init.d/network"], "external_methods": ["uci set", "uci commit", "uci show", "sed", "grep", "tr", "sort", "uniq"], "published": [], "classes": [], "methods": [], "calls": ["/etc/init.d/network reload", "uci set wireless.@wifi-iface[0].isolation='0'", "uci commit wireless", "uci show wireless", "sed 's/@[0-9]\\+/@N/g'", "grep -E 'isolation='", "sort", "uniq", "uci -q set network.globals='globals'", "uci set network.globals.ula_prefix='fd00:dead:beef::/48'", "uci commit network", "sed 's/[0-9a-f]\\{4\\}:[0-9a-f]\\{4\\}:[0-9a-f]\\{4\\}/FD00:DEAD:BEEF/g'", "tr '[:lower:]' '[:upper:]'"], "search-terms": ["UCI", "network reload", "wireless isolation", "uci show", "network.globals", "reload /etc/init.d/network", "UCI set wireless", "wireless.@wifi-iface"], "state": 2, "file_id": 8, "knowledge_revision": 50, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "513a4c021dde73ba092ba2f8ba283958", "format-version": 4, "code-base-name": "cram_sample-2632", "filename": "sample_case/16-uci-set-commit-reload.t", "revision_history": [{"50": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}