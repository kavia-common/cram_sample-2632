{"is_source_file": true, "format": "shell script", "description": "This file is a shell script that tests the addition of an iptables LOG rule, verifies kernel log entries, and then removes the rule. It includes commands for setting environment variables, inserting a log rule, generating test traffic, and checking logs using either logread or dmesg.", "external_files": ["logread", "dmesg"], "external_methods": ["logread", "dmesg"], "published": [], "classes": [], "methods": [], "calls": ["iptables -I INPUT 1 -p tcp --dport 65531 -j LOG --log-prefix \"${LP} \" --log-level 4", "nc -z -w1 127.0.0.1 65531", "logread", "dmesg", "grep -F \"${LP}\"", "tail -n 1", "sed 's/[[:space:]]\\+/ /g'", "iptables -D INPUT -p tcp --dport 65531 -j LOG --log-prefix \"${LP} \" --log-level 4", "echo \"Cleaned LOG rule\""], "search-terms": ["iptables LOG rule", "kernel log verification", "logread", "dmesg", "network packet testing", "iptables cleanup"], "state": 2, "file_id": 15, "knowledge_revision": 58, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "1d54a33b9d8b8dec1baabd2bf25dd750", "format-version": 4, "code-base-name": "cram_sample-2632", "filename": "sample_case/23-iptables-logging.t", "revision_history": [{"58": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}